{
	"compilerOptions": {
		"composite": true,
		"target": "ESNext",
		"lib": ["ESNext"],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"strict": true,
		"types": ["node"]
	},
	"include": ["eslint.config.ts"]
}
