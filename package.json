{
  "name": "@rejc2/projecttemplate-monorepo",
  "packageManager": "yarn@4.12.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "yarn workspaces foreach --all --topological run build",
    "docker:base": "docker build --file ./docker/Dockerfile.base --tag rejc2/projecttemplate-base-image .",
    "docker:compose": "docker compose -f docker-compose.yml up --build",
    "docker:compose:migrate": "COMPOSE_PROFILES=migrate yarn docker:compose",
    "docker:compose:seed": "COMPOSE_PROFILES=seed yarn docker:compose",
    "docker:compose:db": "docker compose -f docker-compose.yml -f docker-compose.db.yml up --build",
    "docker:compose:db:seed": "COMPOSE_PROFILES=seed yarn docker:compose:db",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:extract": "lingui extract",
    "lint": "yarn workspaces foreach --all run lint",
    "lint:strict": "yarn workspaces foreach --all run lint:strict",
    "test": "yarn workspaces foreach --all run test",
    "typecheck": "yarn workspaces foreach --all run typecheck",
    "validate:yaml": "node scripts/validate-yaml-schemas.js"
  },
  "workspaces": [
    "apps/*",
    "dev-packages/*",
    "packages/*",
    "test-packages/*"
  ],
  "devDependencies": {
    "@lingui/cli": "^6.0.1",
    "@lingui/format-po": "^6.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-nginx": "^1.0.3",
    "prettier-plugin-prisma": "^5.0.0",
    "yaml": "^2.8.2"
  }
}
